---
import { render, type CollectionEntry } from "astro:content";
import { Docs } from "@/components/docs";
import defaultMdxComponents from "fumadocs-ui/mdx";
import { CodeBlockPre } from "@/components/code-block";
import "@/styles/global.css";
import { pageTree, source } from "@/lib/source";
import { getPageImageUrl } from "@/lib/shared";
import Layout from "@/components/layout.astro";
import type { TOCItemType } from "fumadocs-core/toc";
import { markdownUrl } from "@/lib/llms";

interface Props {
  page: CollectionEntry<"docs">;
}

export async function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join("/") : undefined },
    props: { page: page.data._raw },
  }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const slugs = typeof Astro.params.slug === "string" ? Astro.params.slug.split("/") : [];
const docsPage = source.getPage(slugs)!;
const image = getPageImageUrl(docsPage).url;
const isHome = slugs.length === 0;
// The section is the root folder: reference, go, python, typescript, else the docs.
const section = ["reference", "go", "python", "typescript"].includes(slugs[0] ?? "") ? slugs[0] : "docs";

const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: "#" + heading.slug,
}));
---

<Layout title={page.data.title} description={page.data.description} image={image} section={section}>
  <Docs
    tree={pageTree()}
    pathname={Astro.url.pathname}
    params={Astro.params}
    page={{ toc }}
    header={{
      title: page.data.title,
      description: page.data.description,
      hero: isHome,
      markdownUrl: markdownUrl(docsPage),
    }}
    client:load
  >
    <div class="prose flex-1">
      <Content components={{ ...defaultMdxComponents, pre: CodeBlockPre }} />
    </div>
  </Docs>
</Layout>
